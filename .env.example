DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bagati?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Canonical public origin: localhost for local testing; https://shopbagati.com in production.
APP_BASE_URL=http://localhost:3000
# Google Cloud OAuth 2.0 web client credentials; server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Automated tests only. Both must be set, NODE_ENV must not be production, and the issuer must be
# http://localhost or http://127.0.0.1. Otherwise the real Google endpoints are used. Never set these in production.
# BAGATI_ALLOW_OAUTH_TEST_ENDPOINTS=1
# BAGATI_GOOGLE_OAUTH_TEST_ISSUER=http://127.0.0.1:9
# Gmail: smtp.gmail.com with port 465 (implicit TLS) or 587 (STARTTLS).
# If Gmail 2-Step Verification is enabled, use a Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Email outbox encrypts verification codes at rest. Optional: when omitted, a
# domain-separated key is derived from SESSION_SECRET. Use a stable 32-byte
# base64 key in production if rotating SESSION_SECRET independently.
EMAIL_ENCRYPTION_KEY=
# Independent 32-byte-or-longer random secret for signed Apache/ModSecurity
# ingestion. Configure only in the server secret store; never commit a real value.
BAGATI_APACHE_INGEST_SECRET=
# Process queued mail periodically with `npm run email:worker` (e.g. every minute).
# Server-owned legal-information fields required before approval; adjust with qualified local policy advice.
BAGATI_SELLER_LEGAL_POLICY='{"INDIVIDUAL_ENTREPRENEUR":["legalName","voen"],"REGISTERED_COMPANY":["legalName","voen","legalAddress"]}'
# Local development asset provider. Switch production to `s3` and set the values below.
BAGATI_STORAGE_DRIVER="local"
# Only set true in production when public/uploads is mounted on durable shared storage.
# Do not enable this on hosted production. Use BAGATI_STORAGE_DRIVER=s3 there.
BAGATI_STORAGE_LOCAL_DURABLE="false"
# Optional per-process image normalization limit. Default 3. Allowed range 1-8.
# BAGATI_STORAGE_PROCESS_LIMIT=3
# S3-compatible provider (AWS S3, Cloudflare R2, MinIO, etc.). Keep access keys server-side.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# Public HTTPS base URL mapped to the bucket root (CDN/custom domain recommended).
S3_PUBLIC_BASE_URL=
# Epoint merchant settings. Leave disabled until the merchant account is activated.
# Copy the endpoint URLs from the authenticated documentation:
# https://developer.epoint.az/en/checkout/request
# https://developer.epoint.az/en/status/get-status
# The official pages hide those URLs until sign-in, so they are not hardcoded here.
# Set result_url in the Epoint cabinet to https://shopbagati.com/api/payments/epoint/callback
# EPOINT_PAYMENTS_ENABLED=0
# EPOINT_ENVIRONMENT=sandbox
# EPOINT_PUBLIC_KEY=
# EPOINT_PRIVATE_KEY=
# EPOINT_CREATE_PAYMENT_URL=
# EPOINT_STATUS_URL=
# OpenStreetMap-compatible tile URL and attribution. Use a tile provider suitable for your production traffic.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
