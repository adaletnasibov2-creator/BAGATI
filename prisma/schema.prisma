/// A customer's request to cancel one store order after the store confirmed it or after payment (rule 2 of
/// lib/order-cancellation.ts). The store decides; approval uses the normal store cancel (stock restored once) and never
/// touches the payment: refunds stay manual. At most one REQUESTED row per store order (partial unique index in the
/// migration, not expressible in this schema).
model OrderCancellationRequest {
  id            String                         @id @default(cuid())
  storeOrderId  String
  customerId    String
  status        OrderCancellationRequestStatus @default(REQUESTED)
  reason        String                         @db.VarChar(500)
  storeResponse String?                        @db.VarChar(1000)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
