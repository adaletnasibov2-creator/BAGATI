generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  NEW
  CONFIRMED
  PREPARING
  READY
  HANDED_TO_COURIER
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum ImportStatus {
  PENDING
  VALIDATING
  COMPLETED
  FAILED
}

enum ImportJobStatus {
  UPLOADING
  QUEUED
  PROCESSING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportJobRowStatus {
  PENDING
  CREATED
  UPDATED
  SKIPPED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
}

enum OrderCancellationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUND_PENDING
  REFUNDED
  EXCHANGE_PENDING
  EXCHANGED
  CANCELLED
}

enum ShipmentStatus {
  PREPARING
  READY_FOR_SHIPMENT
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum StoreOrigin {
  SELLER_SUBMITTED
  ADMIN_CREATED
  LEGACY_UNKNOWN
}

enum SellerType {
  INDIVIDUAL_ENTREPRENEUR
  REGISTERED_COMPANY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

/// Product/feature tier granted by an admin complimentary (free) entitlement.
enum EntitlementTier {
  BASIC
  PRO
}

/// Buyer-to-store contact message status.
enum StoreInquiryStatus {
  NEW
  READ
}

enum SubscriptionAccessSource {
  UNKNOWN
  ADMIN_MANUAL
  PAYMENT_CONFIRMED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                            String                          @id @default(cuid())
  email                         String                          @unique
  passwordHash                  String
  /// Password sign-in is enabled for local accounts; Google linkage alone does not determine this flag.
  passwordAuthEnabled           Boolean                         @default(true)
  role                          Role                            @default(CUSTOMER)
  isActive                      Boolean                         @default(true)
  emailVerifiedAt               DateTime?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  emailVerification             EmailVerification?
  authSessions                  AuthSession[]
  googleAccount                 GoogleAccount?
  googleLinkTransactions        GoogleLinkTransaction[]
  passwordResetTokens           PasswordResetToken[]
  customerProfile               CustomerProfile?
  vendorProfile                 VendorProfile?
  addresses                     Address[]
  cart                          Cart?
  orders                        Order[]
  reviews                       Review[]
  notifications                 Notification[]
  inventoryAdjustments          InventoryAdjustment[]
  supportTickets                SupportTicket[]
  returnRequests                ReturnRequest[]
  auditLogs                     AuditLog[]
  adminManagedStores            Store[]                         @relation("AdminManagedStores")
  subscriptionGrants            StoreSubscription[]             @relation("SubscriptionGrantAdmin")
  complimentaryGrants           StoreComplimentaryEntitlement[] @relation("StoreComplimentaryEntitlementGrantedBy")
  complimentaryRevocations      StoreComplimentaryEntitlement[] @relation("StoreComplimentaryEntitlementRevokedBy")
  catalogImportJobs             ImportJob[]                     @relation("CatalogImportJobCreator")
  adminTwoFactor                AdminTwoFactor?
  adminRecoveryCodes            AdminRecoveryCode[]
  vendorApplications            VendorApplication[]             @relation("VendorApplicationApplicant")
  reviewedVendorApplications    VendorApplication[]             @relation("VendorApplicationReviewer")
  siteSettingUpdates            SiteSetting[]                   @relation("SiteSettingUpdatedBy")
  siteSettingRevisions          SiteSettingRevision[]           @relation("SiteSettingRevisionBy")
  securityRuleUpdates           SecurityAlertRule[]             @relation("SecurityAlertRuleUpdatedBy")
  assignedSecurityIncidents     SecurityIncident[]              @relation("SecurityIncidentAssignee")
  acknowledgedSecurityIncidents SecurityIncident[]              @relation("SecurityIncidentAcknowledgedBy")
  resolvedSecurityIncidents     SecurityIncident[]              @relation("SecurityIncidentResolvedBy")
  securityIncidentNotes         SecurityIncidentNote[]
  contentPageUpdates            ContentPage[]                   @relation("ContentPageUpdatedBy")
  contentPageRevisions          ContentPageRevision[]           @relation("ContentPageRevisionCreatedBy")
  voenVerifications             SellerVoenVerification[]        @relation("SellerVoenVerificationSeller")
  voenVerificationsGiven        SellerVoenVerification[]        @relation("SellerVoenVerificationVerifiedBy")
  voenVerificationsRevoked      SellerVoenVerification[]        @relation("SellerVoenVerificationRevokedBy")
  cancellationRequests          OrderCancellationRequest[]      @relation("OrderCancellationRequestCustomer")
  cancellationDecisions         OrderCancellationRequest[]      @relation("OrderCancellationRequestDecidedBy")
  conversations                 Conversation[]                  @relation("ConversationCustomer")
  conversationMessages          ConversationMessage[]           @relation("ConversationMessageSender")
  conversationBlocks            ConversationBlock[]             @relation("ConversationBlockCustomer")
  conversationReports           ConversationReport[]            @relation("ConversationReportReporter")
  conversationReportReviews     ConversationReport[]            @relation("ConversationReportReviewer")
  legalAcceptances              LegalAcceptance[]

  @@index([role, isActive])
}

model GoogleAccount {
  id        String   @id @default(cuid())
  googleSub String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

/// A verified Google identity waiting for the existing account's own password login. Email equality alone never creates a session or a link.
model GoogleLinkTransaction {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  googleSub String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, usedAt])
  @@index([googleSub])
  @@index([expiresAt])
}

model AuthSession {
  id         String    @id
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  /// Admin sessions only: last request (written at most every 5 minutes), used for the idle timeout and the session list.
  lastSeenAt DateTime?
  /// Admin sessions only: masked client IP (e.g. 203.0.*.*), never the full address. Null when no trusted IP is available.
  ipMasked   String?   @db.VarChar(64)
  /// Admin sessions only: short browser summary (e.g. "Chrome 140 · Windows"), never the full User-Agent header.
  userAgent  String?   @db.VarChar(120)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// Admin TOTP second factor, one row per admin. A row with enrolledAt = null is an unfinished enrollment.
model AdminTwoFactor {
  userId          String    @id
  /// AES-256-GCM ciphertext ("v1.iv.tag.ct") under BAGATI_ADMIN_2FA_KEY, bound to userId. Never the plain secret.
  secretEncrypted String    @db.VarChar(512)
  enrolledAt      DateTime?
  /// Highest TOTP time step accepted so far; codes for this step or older are rejected (replay protection).
  lastUsedStep    Int?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Single-use admin 2FA recovery codes, stored only as scrypt hashes.
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(200)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthRateLimit {
  keyHash         String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model EmailVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  codeHash              String
  expiresAt             DateTime
  attempts              Int       @default(0)
  lastSentAt            DateTime?
  resendCount           Int       @default(0)
  resendWindowStartedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Single-use link that verifies a store's extra notification email (SELLER-ALERTS). Only the SHA-256 hash of the
/// random token is stored. `email` is the address the link was sent to: it verifies only while the store still has
/// exactly that address. Expires after 24 hours.
model StoreNotificationEmailToken {
  id        String    @id @default(cuid())
  storeId   String
  email     String    @db.VarChar(254)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, usedAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id              String            @id @default(cuid())
  dedupeKey       String            @unique
  recipient       String
  template        String
  payload         Json
  status          EmailOutboxStatus @default(PENDING)
  attempts        Int               @default(0)
  availableAt     DateTime          @default(now())
  lockedAt        DateTime?
  sentAt          DateTime?
  lastErrorCode   String?
  retrySafe       Boolean           @default(false)
  failureCategory String?
  smtpCodeClass   String?
  /// Latest unresolved delivery failure. Set for a retryable failure, a permanent failure, and stale-lock reconciliation. Retained while the retry waits. Cleared when the next attempt is claimed and when SENT is stored. Null means there is no current failure.
  failedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([createdAt])
}

/// Liveness of the in-process email worker (lib/email-worker-loop.ts). One row, id "email-outbox".
/// Written only by the process that holds the outbox advisory lock, so every instance reads the same state.
/// Holds timestamps, counts and allowlisted error codes only: never recipients, payloads or messages.
model EmailWorkerHeartbeat {
  id                   String    @id
  startedAt            DateTime
  heartbeatAt          DateTime
  lastPollStartedAt    DateTime?
  lastPollCompletedAt  DateTime?
  lastSuccessfulPollAt DateTime?
  lastPollErrorCode    String?
  lastPollErrorType    String?
  lastPollProcessed    Int?
  lastPollSent         Int?
  lastPollFailed       Int?
  stoppedAt            DateTime?
  updatedAt            DateTime  @updatedAt
}

model CustomerProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  firstName String?
  lastName  String?
  phone     String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id           String              @id @default(cuid())
  userId       String              @unique
  displayName  String
  phone        String?
  sellerType   SellerType?
  legalName    String?
  voen         String?
  legalAddress String?
  stores       Store[]
  applications VendorApplication[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VendorApplicationSource {
  SELF
  ADMIN
  LEGACY
}

/// A customer's request to become a seller. The role stays CUSTOMER until an admin approves.
/// VendorProfile stays the single live source of seller details; this row is the submitted snapshot and its review.
/// CHECK constraints (migration 20261113030000) keep openUserId = userId exactly while PENDING (one open
/// application per user through the unique index), require a reason on REJECTED and a 10-digit VOEN on SELF rows.
model VendorApplication {
  id                     String                  @id @default(cuid())
  userId                 String
  status                 VendorApplicationStatus @default(PENDING)
  source                 VendorApplicationSource @default(SELF)
  /// Equals userId while PENDING, NULL otherwise. Unique, so a user can have only one open application.
  openUserId             String?                 @unique
  displayName            String
  phone                  String?
  sellerType             SellerType?
  legalName              String?
  voen                   String?
  /// Digits only; used to find the same VOEN on other profiles and applications.
  voenNormalized         String?
  legalAddress           String?
  plannedStoreName       String?
  /// Written by the applicant, visible to admins only. At most 1000 characters (CHECK).
  applicantNote          String?
  /// Internal admin note, never shown to the applicant. At most 1000 characters (CHECK).
  adminNote              String?
  /// Shown to the applicant. Required when REJECTED, at most 500 characters (CHECK).
  rejectionReason        String?
  duplicateVoenConfirmed Boolean                 @default(false)
  vendorProfileId        String?
  reviewedById           String?
  reviewedAt             DateTime?
  withdrawnAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation("VendorApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                   @relation("VendorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  vendorProfile          VendorProfile?          @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)
  legalAcceptances       LegalAcceptance[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([voenNormalized])
}

/// An admin's manual check of a seller's VÖEN on the official taxpayer search (there is no public API).
/// Keyed on (user, VÖEN): the seller's VendorProfile or open application VÖEN is "Təsdiqlənib" only while a row with
/// that exact VÖEN exists and revokedAt is NULL. Changing the VÖEN revokes the user's rows; history is in AuditLog.
model SellerVoenVerification {
  id           String    @id @default(cuid())
  userId       String
  /// 10 digits (lib/voen.ts format).
  voen         String
  verifiedAt   DateTime
  verifiedById String?
  /// Required short admin note (what was checked), at most 300 characters (app-level).
  verifiedNote String
  revokedAt    DateTime?
  revokedById  String?
  revokedNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("SellerVoenVerificationSeller", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?     @relation("SellerVoenVerificationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  revokedBy    User?     @relation("SellerVoenVerificationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, voen])
  @@index([voen])
}

enum LegalDocument {
  CUSTOMER_TERMS
  SELLER_TERMS
}

enum LegalAcceptanceSource {
  REGISTER_EMAIL
  REGISTER_GOOGLE
  CHECKOUT
  SELLER_APPLICATION
  SELLER_PANEL
}

/// One row per user, document and version: the user accepted that version of the legal text (lib/legal-acceptance.ts).
/// Written only by the server, in the same transaction as the action. No IP address or user agent is stored
/// (owner decision 2026-11-18). Rows go with the user (Cascade); no backfill for accounts created before this table.
model LegalAcceptance {
  id                  String                @id @default(cuid())
  userId              String
  document            LegalDocument
  /// LEGAL_VERSIONS[document] at the time of acceptance (lib/legal-versions.ts), e.g. "2026-11-17".
  version             String                @db.VarChar(32)
  source              LegalAcceptanceSource
  acceptedAt          DateTime              @default(now())
  vendorApplicationId String?
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorApplication   VendorApplication?    @relation(fields: [vendorApplicationId], references: [id], onDelete: SetNull)

  @@unique([userId, document, version])
  @@index([document, version])
  @@index([vendorApplicationId])
}

model City {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  countryCode String    @default("AZ")
  isActive    Boolean   @default(true)
  stores      Store[]
  addresses   Address[]
}

model Store {
  id                          String                          @id @default(cuid())
  vendorId                    String
  cityId                      String
  name                        String
  slug                        String                          @unique
  description                 String?
  logoUrl                     String?
  bannerUrl                   String?
  theme                       String                          @default("forest")
  status                      StoreStatus                     @default(DRAFT)
  origin                      StoreOrigin                     @default(LEGACY_UNKNOWN)
  isActive                    Boolean                         @default(false)
  address                     String?
  latitude                    Float?
  longitude                   Float?
  mapUrl                      String?
  contactPhone                String?
  contactEmail                String?
  reviewNote                  String?
  legalInfoApproved           Boolean                         @default(false)
  adminManaged                Boolean                         @default(false)
  managedByAdminId            String?
  managementReason            String?
  freeDeliveryThreshold       Decimal                         @default(30.00) @db.Decimal(12, 2)
  deliveryFee                 Decimal                         @default(0.00) @db.Decimal(12, 2)
  /// Optional extra address for new-order emails (SELLER-ALERTS). Stored lower-cased. Receives order emails only while
  /// notificationEmailVerifiedAt is set; changing the address clears it. The seller's account email always receives them.
  notificationEmail           String?                         @db.VarChar(254)
  notificationEmailVerifiedAt DateTime?
  /// Optional opening hours, ONE range for every day, "HH:MM" (STORE-HOURS). Both set or both NULL, never equal; a closing
  /// time earlier than the opening time is overnight. Information only: never read by order/cart/checkout/payment/email.
  openingTime                 String?                         @db.VarChar(5)
  closingTime                 String?                         @db.VarChar(5)
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  vendor                      VendorProfile                   @relation(fields: [vendorId], references: [id])
  managedByAdmin              User?                           @relation("AdminManagedStores", fields: [managedByAdminId], references: [id], onDelete: SetNull)
  city                        City                            @relation(fields: [cityId], references: [id])
  products                    Product[]
  storeOrders                 StoreOrder[]
  promotions                  Promotion[]
  homepageFeatured            HomepageFeaturedStore?
  commissions                 Commission[]
  notifications               Notification[]
  subscription                StoreSubscription?
  complimentaryEntitlements   StoreComplimentaryEntitlement[]
  returnRequests              ReturnRequest[]
  catalogImportJobs           ImportJob[]
  inquiries                   StoreInquiry[]
  conversations               Conversation[]
  conversationBlocks          ConversationBlock[]
  notificationEmailTokens     StoreNotificationEmailToken[]

  @@index([vendorId, cityId])
  @@index([cityId, isActive])
  @@index([status])
  @@index([origin])
  @@index([adminManaged, managedByAdminId])
}

model StoreComplimentaryEntitlement {
  id               String          @id @default(cuid())
  storeId          String
  grantedByAdminId String
  grantedAt        DateTime        @default(now())
  grantReason      String          @db.VarChar(500)
  /// Limits and features of the free grant. BASIC unless the admin chooses PRO.
  tier             EntitlementTier @default(BASIC)
  /// Optional end of the free grant (exclusive). Null means no end date.
  endsAt           DateTime?
  revokedAt        DateTime?
  revokedByAdminId String?
  revokeReason     String?         @db.VarChar(500)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedByAdmin   User            @relation("StoreComplimentaryEntitlementGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedByAdmin   User?           @relation("StoreComplimentaryEntitlementRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([storeId, grantedAt])
  @@index([storeId, revokedAt])
  @@index([grantedByAdminId, grantedAt])
  @@index([revokedByAdminId, revokedAt])
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  cityId        String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City    @relation(fields: [cityId], references: [id])

  @@index([userId])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  /// At most two levels: a subcategory's parent is always a top-level category. Enforced in
  /// lib/category-tree.ts and by the "category_tree_guard" trigger (migration 20261116010000).
  parentId  String?
  isActive  Boolean    @default(true)
  /// Ascending display order among siblings (top-levels: 10, 20, ...; "Digər" 1000).
  sortOrder Int        @default(0)
  /// Key from the allowlist in lib/category-icons.ts; an unknown key renders no icon.
  iconKey   String?
  /// Admin-uploaded photo (same storage and URL rules as homepage images).
  imageUrl  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId, sortOrder])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id                String                   @id @default(cuid())
  storeId           String
  categoryId        String?
  brandId           String?
  sku               String?
  name              String
  slug              String
  description       String?
  price             Decimal                  @db.Decimal(12, 2)
  discountPrice     Decimal?                 @db.Decimal(12, 2)
  status            ProductStatus            @default(DRAFT)
  images            String[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category?                @relation(fields: [categoryId], references: [id])
  brand             Brand?                   @relation(fields: [brandId], references: [id])
  variants          ProductVariant[]
  inventory         Inventory[]
  orderItems        OrderItem[]
  reviews           Review[]
  cartItems         CartItem[]
  promotionProducts PromotionProduct[]
  homepageFeatured  HomepageFeaturedProduct?
  conversations     Conversation[]

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([categoryId, status])
  @@index([storeId, status])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, name, id])
  @@index([categoryId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  sku           String?     @unique
  name          String
  options       Json
  isActive      Boolean     @default(true)
  price         Decimal?    @db.Decimal(12, 2)
  discountPrice Decimal?    @db.Decimal(12, 2)
  images        String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId, isActive])
}

model Inventory {
  id                String                @id @default(cuid())
  productId         String
  variantId         String?
  quantity          Int                   @default(0)
  reserved          Int                   @default(0)
  updatedAt         DateTime              @updatedAt
  lowStockThreshold Int                   @default(5)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustments       InventoryAdjustment[]

  @@unique([productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model InventoryAdjustment {
  id               String    @id @default(cuid())
  inventoryId      String
  actorUserId      String
  delta            Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  createdAt        DateTime  @default(now())
  inventory        Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor            User      @relation(fields: [actorUserId], references: [id])

  @@index([inventoryId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
