  action        String   @db.VarChar(32)
  ruleId        String?  @db.VarChar(128)
  /// Masked form of sourceIp ("203.0.*.*"); kept after the raw IP is cleared (7 days). Shown in the UI instead of sourceIp.
  sourceIpMasked String? @db.VarChar(64)
  createdAt     DateTime @default(now())

  @@unique([source, sourceEventId])
  @@index([occurredAt])
