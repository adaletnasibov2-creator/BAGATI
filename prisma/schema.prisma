generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  NEW
  CONFIRMED
  PREPARING
  READY
  HANDED_TO_COURIER
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum ImportStatus {
  PENDING
  VALIDATING
  COMPLETED
  FAILED
}

enum ImportJobStatus {
  UPLOADING
  QUEUED
  PROCESSING
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportJobRowStatus {
  PENDING
  CREATED
  UPDATED
  SKIPPED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUND_PENDING
  REFUNDED
  EXCHANGE_PENDING
  EXCHANGED
  CANCELLED
}

enum ShipmentStatus {
  PREPARING
  READY_FOR_SHIPMENT
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum StoreOrigin {
  SELLER_SUBMITTED
  ADMIN_CREATED
  LEGACY_UNKNOWN
}

enum SellerType {
  INDIVIDUAL_ENTREPRENEUR
  REGISTERED_COMPANY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

/// Product/feature tier granted by an admin complimentary (free) entitlement.
enum EntitlementTier {
  BASIC
  PRO
}

/// Buyer-to-store contact message status.
enum StoreInquiryStatus {
  NEW
  READ
}

enum SubscriptionAccessSource {
  UNKNOWN
  ADMIN_MANUAL
  PAYMENT_CONFIRMED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String
  /// Password sign-in is enabled for local accounts; Google linkage alone does not determine this flag.
  passwordAuthEnabled   Boolean               @default(true)
  role                  Role                  @default(CUSTOMER)
  isActive              Boolean               @default(true)
  emailVerifiedAt       DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  emailVerification      EmailVerification?
  authSessions          AuthSession[]
  googleAccount         GoogleAccount?
  googleLinkTransactions GoogleLinkTransaction[]
  passwordResetTokens   PasswordResetToken[]
  customerProfile       CustomerProfile?
  vendorProfile         VendorProfile?
  addresses             Address[]
  cart                  Cart?
  orders                Order[]
  reviews               Review[]
  notifications         Notification[]
  inventoryAdjustments  InventoryAdjustment[]
  supportTickets        SupportTicket[]
  returnRequests        ReturnRequest[]
  auditLogs             AuditLog[]
  adminManagedStores    Store[]                @relation("AdminManagedStores")
  subscriptionGrants    StoreSubscription[]    @relation("SubscriptionGrantAdmin")
  complimentaryGrants       StoreComplimentaryEntitlement[] @relation("StoreComplimentaryEntitlementGrantedBy")
  complimentaryRevocations StoreComplimentaryEntitlement[] @relation("StoreComplimentaryEntitlementRevokedBy")
  catalogImportJobs     ImportJob[]            @relation("CatalogImportJobCreator")
  adminTwoFactor        AdminTwoFactor?
  adminRecoveryCodes    AdminRecoveryCode[]
  vendorApplications    VendorApplication[]    @relation("VendorApplicationApplicant")
  reviewedVendorApplications VendorApplication[] @relation("VendorApplicationReviewer")
  siteSettingUpdates    SiteSetting[]          @relation("SiteSettingUpdatedBy")
  siteSettingRevisions  SiteSettingRevision[]  @relation("SiteSettingRevisionBy")
  securityRuleUpdates   SecurityAlertRule[]    @relation("SecurityAlertRuleUpdatedBy")
  assignedSecurityIncidents     SecurityIncident[] @relation("SecurityIncidentAssignee")
  acknowledgedSecurityIncidents SecurityIncident[] @relation("SecurityIncidentAcknowledgedBy")
  resolvedSecurityIncidents     SecurityIncident[] @relation("SecurityIncidentResolvedBy")
  securityIncidentNotes SecurityIncidentNote[]

  @@index([role, isActive])
}

model GoogleAccount {
  id                String   @id @default(cuid())
  googleSub         String   @unique
  userId            String   @unique
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

/// A verified Google identity waiting for the existing account's own password login. Email equality alone never creates a session or a link.
model GoogleLinkTransaction {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  googleSub  String
  email      String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, usedAt])
  @@index([googleSub])
  @@index([expiresAt])
}

model AuthSession {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Admin sessions only: last request (written at most every 5 minutes), used for the idle timeout and the session list.
  lastSeenAt DateTime?
  /// Admin sessions only: masked client IP (e.g. 203.0.*.*), never the full address. Null when no trusted IP is available.
  ipMasked  String?   @db.VarChar(64)
  /// Admin sessions only: short browser summary (e.g. "Chrome 140 · Windows"), never the full User-Agent header.
  userAgent String?   @db.VarChar(120)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// Admin TOTP second factor, one row per admin. A row with enrolledAt = null is an unfinished enrollment.
model AdminTwoFactor {
  userId          String    @id
  /// AES-256-GCM ciphertext ("v1.iv.tag.ct") under BAGATI_ADMIN_2FA_KEY, bound to userId. Never the plain secret.
  secretEncrypted String    @db.VarChar(512)
  enrolledAt      DateTime?
  /// Highest TOTP time step accepted so far; codes for this step or older are rejected (replay protection).
  lastUsedStep    Int?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Single-use admin 2FA recovery codes, stored only as scrypt hashes.
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(200)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthRateLimit {
  keyHash         String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model EmailVerification {
  id                    String   @id @default(cuid())
  userId                String   @unique
  codeHash              String
  expiresAt             DateTime
  attempts              Int      @default(0)
  lastSentAt            DateTime?
  resendCount           Int      @default(0)
  resendWindowStartedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailOutbox {
  id            String           @id @default(cuid())
  dedupeKey     String           @unique
  recipient     String
  template      String
  payload       Json
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int              @default(0)
  availableAt   DateTime         @default(now())
  lockedAt      DateTime?
  sentAt        DateTime?
  lastErrorCode   String?
  retrySafe       Boolean          @default(false)
  failureCategory String?
  smtpCodeClass   String?
  /// Latest unresolved delivery failure. Set for a retryable failure, a permanent failure, and stale-lock reconciliation. Retained while the retry waits. Cleared when the next attempt is claimed and when SENT is stored. Null means there is no current failure.
  failedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([createdAt])
}

model CustomerProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  firstName String?
  lastName  String?
  phone     String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  phone       String?
  sellerType  SellerType?
  legalName   String?
  voen        String?
  legalAddress String?
  stores      Store[]
  applications VendorApplication[]
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VendorApplicationSource {
  SELF
  ADMIN
  LEGACY
}

/// A customer's request to become a seller. The role stays CUSTOMER until an admin approves.
/// VendorProfile stays the single live source of seller details; this row is the submitted snapshot and its review.
/// CHECK constraints (migration 20261113030000) keep openUserId = userId exactly while PENDING (one open
/// application per user through the unique index), require a reason on REJECTED and a 10-digit VOEN on SELF rows.
model VendorApplication {
  id                     String                  @id @default(cuid())
  userId                 String
  status                 VendorApplicationStatus @default(PENDING)
  source                 VendorApplicationSource @default(SELF)
  /// Equals userId while PENDING, NULL otherwise. Unique, so a user can have only one open application.
  openUserId             String?                 @unique
  displayName            String
  phone                  String?
  sellerType             SellerType?
  legalName              String?
  voen                   String?
  /// Digits only; used to find the same VOEN on other profiles and applications.
  voenNormalized         String?
  legalAddress           String?
  plannedStoreName       String?
  /// Written by the applicant, visible to admins only. At most 1000 characters (CHECK).
  applicantNote          String?
  /// Internal admin note, never shown to the applicant. At most 1000 characters (CHECK).
  adminNote              String?
  /// Shown to the applicant. Required when REJECTED, at most 500 characters (CHECK).
  rejectionReason        String?
  duplicateVoenConfirmed Boolean                 @default(false)
  vendorProfileId        String?
  reviewedById           String?
  reviewedAt             DateTime?
  withdrawnAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation("VendorApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                   @relation("VendorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  vendorProfile          VendorProfile?          @relation(fields: [vendorProfileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([voenNormalized])
}

model City {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  countryCode String    @default("AZ")
  isActive    Boolean   @default(true)
  stores      Store[]
  addresses   Address[]
}

model Store {
  id             String             @id @default(cuid())
  vendorId       String
  cityId         String
  name           String
  slug           String             @unique
  description    String?
  logoUrl        String?
  bannerUrl      String?
  theme          String             @default("forest")
  status         StoreStatus        @default(DRAFT)
  origin         StoreOrigin        @default(LEGACY_UNKNOWN)
  isActive       Boolean            @default(false)
  address        String?
  latitude       Float?
  longitude      Float?
  mapUrl         String?
  contactPhone   String?
  contactEmail   String?
  reviewNote     String?
  legalInfoApproved Boolean @default(false)
  adminManaged      Boolean            @default(false)
  managedByAdminId  String?
  managementReason  String?
  freeDeliveryThreshold Decimal @default(30.00) @db.Decimal(12, 2)
  deliveryFee    Decimal @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  vendor         VendorProfile      @relation(fields: [vendorId], references: [id])
  managedByAdmin User?              @relation("AdminManagedStores", fields: [managedByAdminId], references: [id], onDelete: SetNull)
  city           City               @relation(fields: [cityId], references: [id])
  products       Product[]
  storeOrders    StoreOrder[]
  promotions     Promotion[]
  homepageFeatured HomepageFeaturedStore?
  commissions    Commission[]
  notifications  Notification[]
  subscription   StoreSubscription?
  complimentaryEntitlements StoreComplimentaryEntitlement[]
  returnRequests ReturnRequest[]
  catalogImportJobs ImportJob[]
  inquiries      StoreInquiry[]

  @@index([vendorId, cityId])
  @@index([cityId, isActive])
  @@index([status])
  @@index([origin])
  @@index([adminManaged, managedByAdminId])
}

model StoreComplimentaryEntitlement {
  id              String    @id @default(cuid())
  storeId          String
  grantedByAdminId String
  grantedAt        DateTime  @default(now())
  grantReason      String    @db.VarChar(500)
  /// Limits and features of the free grant. BASIC unless the admin chooses PRO.
  tier             EntitlementTier @default(BASIC)
  /// Optional end of the free grant (exclusive). Null means no end date.
  endsAt           DateTime?
  revokedAt        DateTime?
  revokedByAdminId String?
  revokeReason     String?   @db.VarChar(500)
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedByAdmin   User      @relation("StoreComplimentaryEntitlementGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedByAdmin   User?     @relation("StoreComplimentaryEntitlementRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([storeId, grantedAt])
  @@index([storeId, revokedAt])
  @@index([grantedByAdminId, grantedAt])
  @@index([revokedByAdminId, revokedAt])
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  cityId        String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City    @relation(fields: [cityId], references: [id])

  @@index([userId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  isActive Boolean    @default(true)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id            String           @id @default(cuid())
  storeId       String
  categoryId    String?
  brandId       String?
  sku           String?
  name          String
  slug          String
  description   String?
  price         Decimal          @db.Decimal(12, 2)
  discountPrice Decimal?         @db.Decimal(12, 2)
  status        ProductStatus    @default(DRAFT)
  images        String[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id])
  brand         Brand?           @relation(fields: [brandId], references: [id])
  variants      ProductVariant[]
  inventory     Inventory[]
  orderItems    OrderItem[]
  reviews       Review[]
  cartItems     CartItem[]
  promotionProducts PromotionProduct[]
  homepageFeatured HomepageFeaturedProduct?

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([categoryId, status])
  @@index([storeId, status])
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  sku          String?     @unique
  name         String
  options      Json
  isActive     Boolean     @default(true)
  price        Decimal?    @db.Decimal(12, 2)
  discountPrice Decimal?   @db.Decimal(12, 2)
  images       String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId, isActive])
}

model Inventory {
  id                 String            @id @default(cuid())
  productId          String
  variantId          String?
  quantity           Int               @default(0)
  reserved           Int               @default(0)
  updatedAt          DateTime          @updatedAt
  lowStockThreshold  Int               @default(5)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustments        InventoryAdjustment[]

  @@unique([productId, variantId])
  @@index([productId])
}

model InventoryAdjustment {
  id               String    @id @default(cuid())
  inventoryId      String
  actorUserId      String
  delta            Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  createdAt        DateTime  @default(now())
  inventory        Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor            User      @relation(fields: [actorUserId], references: [id])

  @@index([inventoryId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  status          OrderStatus  @default(PENDING)
  subtotal        Decimal      @db.Decimal(12, 2)
  deliveryFee     Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  addressSnapshot Json
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id])
  storeOrders     StoreOrder[]
  payments        Payment[]
  delivery        Delivery?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StoreOrder {
  id                 String      @id @default(cuid())
  orderId            String
  storeId            String
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(12, 2)
  commissionRateSnapshot Decimal? @db.Decimal(5, 4)
  deliveryFee        Decimal     @default(0.00) @db.Decimal(12, 2)
  deliveryMethod     String?
  deliveryNote       String?
  deliveryCarrier    String?
  deliveryTrackingCode String?
  shipmentStatus     ShipmentStatus?
  trackingUrl        String?
  shippedAt          DateTime?
  outForDeliveryAt   DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime    @default(now())
  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store              Store       @relation(fields: [storeId], references: [id])
  items              OrderItem[]
  returnRequests     ReturnRequest[]

  @@unique([orderId, storeId])
  @@index([storeId, status, createdAt])
}

model OrderItem {
  id           String     @id @default(cuid())
  storeOrderId String
  productId    String
  variantId    String?
  productName  String
  variantName  String?
  variantOptions Json?
  sku          String?
  unitPrice    Decimal    @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal    @db.Decimal(12, 2)
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnRequest ReturnRequest?

  @@index([productId])
  @@index([variantId])
}

model ReturnRequest {
  id             String           @id @default(cuid())
  orderItemId    String           @unique
  storeOrderId   String
  storeId        String
  customerId     String
  reason         String
  explanation    String?
  resolution     ReturnResolution
  status         ReturnStatus     @default(REQUESTED)
  refundAmount   Decimal          @db.Decimal(12, 2)
  vendorResponse String?
  adminNote      String?
  stockRestoredAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItem      OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  storeOrder     StoreOrder       @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer       User             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeOrderId, status])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String?
  providerReference String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("AZN")
  createdAt         DateTime      @default(now())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model Delivery {
  id           String    @id @default(cuid())
  orderId      String    @unique
  carrier      String?
  trackingCode String?
  status       String    @default("PENDING")
  estimatedAt  DateTime?
  deliveredAt  DateTime?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Promotion {
  id            String    @id @default(cuid())
  storeId       String?
  name          String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean   @default(false)
  discountType  String?
  discountValue Decimal?  @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store         Store?    @relation(fields: [storeId], references: [id])
  products      PromotionProduct[]

  @@index([isActive, startsAt, endsAt])
  @@index([storeId, startsAt, endsAt])
}

model PromotionProduct {
  id           String    @id @default(cuid())
  promotionId  String
  productId    String
  createdAt    DateTime  @default(now())
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId, promotionId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Decimal   @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?

  @@index([startsAt, endsAt])
}

model SiteSettings {
  id                    String   @id @default("default")
  siteName              String   @default("BAGATI Marketplace")
  logoUrl               String?
  contactPhone          String?
  contactEmail          String?
  instagramUrl          String?
  facebookUrl           String?
  tiktokUrl             String?
  deliveryInfo          String   @default("")
  returnsInfo           String   @default("")
  homeIntroTitle        String   @default("Mağazaları və məhsulları bir məkanda kəşf et.")
  homeIntroDescription  String   @default("Kataloqa nəzər sal, mağazaları araşdır və sənə uyğun seçimi et.")
  homeIntroLinkLabel    String   @default("Kataloqa bax")
  homeIntroLinkUrl      String   @default("/categories")
  updatedAt             DateTime @updatedAt
}

enum SiteSettingAction {
  UPDATE
  RESET
  ROLLBACK
}

/// One row per changed setting of the settings engine. Keys and their types, bounds and defaults live in
/// lib/settings/registry.ts; a key without a row (or with value NULL) uses the code default.
/// CHECK constraints (migration 20261114010000): key format, value <= 16384 bytes, version >= 1.
model SiteSetting {
  key         String    @id
  /// NULL = use the code default. Validated by the registry on every write and every read.
  value       Json?
  /// Optimistic concurrency: a write must name the version it read.
  version     Int       @default(1)
  updatedById String?
  updatedAt   DateTime  @updatedAt
  updatedBy   User?     @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// History of every settings change; never rewritten. A rollback adds a new revision.
/// CHECK constraints (migration 20261114010000): key format, version >= 1, reason <= 500, values <= 16384 bytes.
model SiteSettingRevision {
  id            String            @id @default(cuid())
  key           String
  /// The SiteSetting.version this change produced.
  version       Int
  /// NULL = reset to the code default.
  value         Json?
  previousValue Json?
  action        SiteSettingAction
  reason        String?
  changedById   String?
  createdAt     DateTime          @default(now())
  changedBy     User?             @relation("SiteSettingRevisionBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([key, version])
  @@index([key, createdAt])
}

